# Copy to .env (gitignored) and fill in. Real environment variables override this file.
#
# Policy (break glass list, managed group allowlist) is NOT configured here. It lives in
# packages/identity-gateway/src/policy/config.ts, in version control, on purpose. See README.

# One tenant, two app registrations with disjoint Graph permissions (SPRINT2.md, Stage A).
# The tenant is shared; the client id, cert path and thumbprint are not.
AZURE_TENANT_ID=

# Entra app registration "helpdesk-identity-gateway". Certificate credential only; no secrets.
AZURE_IDENTITY_CLIENT_ID=
# SHA-1 thumbprint of the uploaded certificate, 40 hex characters as the portal shows it.
AZURE_IDENTITY_CERT_THUMBPRINT=
# Absolute path to the PEM private key. Keep it outside the repo.
AZURE_IDENTITY_CERT_PATH=

# Entra app registration "helpdesk-mdm-gateway". Device.Read.All only; a separate certificate,
# never the identity gateway's key.
AZURE_MDM_CLIENT_ID=
# SHA-1 thumbprint of the uploaded certificate, 40 hex characters as the portal shows it.
AZURE_MDM_CERT_THUMBPRINT=
# Absolute path to the PEM private key. Keep it outside the repo.
AZURE_MDM_CERT_PATH=

# Used only for the approval rationale (Component 4). One model call per approval record.
# Leave empty to run without rationales (the gateway warns at startup).
ANTHROPIC_API_KEY=
# Optional. Model for that call. Default: claude-opus-5
HELPDESK_RATIONALE_MODEL=

# Optional. SQLite file holding the audit log and approvals. Default: data/identity-helpdesk.db
HELPDESK_DB_PATH=

# Optional. Port for the web app (packages/web). Default: 3000
WEB_PORT=
