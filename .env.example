# Copy to .env (gitignored) and fill in. Real environment variables override this file.
#
# Policy (break glass list, managed group allowlist) is NOT configured here. It lives in
# packages/identity-gateway/src/policy/config.ts, in version control, on purpose. See README.

# One tenant, two app registrations with disjoint Graph permissions (SPRINT2.md, Stage A).
# The tenant is shared; the client id, cert path and thumbprint are not.
AZURE_TENANT_ID=

# Entra app registration "helpdesk-identity-gateway". Certificate credential only; no secrets.
AZURE_IDENTITY_CLIENT_ID=
# SHA-1 thumbprint of the uploaded certificate, 40 hex characters as the portal shows it.
AZURE_IDENTITY_CERT_THUMBPRINT=
# Absolute path to the PEM private key. Keep it outside the repo.
AZURE_IDENTITY_CERT_PATH=

# Entra app registration "helpdesk-mdm-gateway". Device.Read.All only; a separate certificate,
# never the identity gateway's key.
AZURE_MDM_CLIENT_ID=
# SHA-1 thumbprint of the uploaded certificate, 40 hex characters as the portal shows it.
AZURE_MDM_CERT_THUMBPRINT=
# Absolute path to the PEM private key. Keep it outside the repo.
AZURE_MDM_CERT_PATH=

# Stage B: each gateway's own Application ID URI (Expose an API), the value a bearer token's
# aud claim must equal before that gateway will honour it. SPRINT3.md, 3.3 and 3.4: the knowledge
# and endpoint gateways get one too, even though — unlike the two below — they have no
# Graph-scoped credential of their own at all: this is the only Entra-issued value either needs,
# since each only validates tokens, never mints one. The endpoint gateway's API permissions page
# is empty for a different reason than the knowledge gateway's: password reset was moved to the
# never-automated class before this gateway was built, so no Graph permission for it was ever
# requested (see the README, "Endpoint gateway notes").
IDENTITY_GATEWAY_AUDIENCE=
MDM_GATEWAY_AUDIENCE=
KNOWLEDGE_GATEWAY_AUDIENCE=
ENDPOINT_GATEWAY_AUDIENCE=

# Stage B: each agent's own app registration, granted the Gateway.Invoke role on exactly one
# gateway's API and no Graph permission at all. A separate certificate from that gateway's own
# (AZURE_IDENTITY_CLIENT_ID / AZURE_MDM_CLIENT_ID above) — these authenticate the agent to its
# gateway over HTTP, they never touch Graph. The web app reuses the identity AND endpoint agents'
# credentials below rather than getting new identities of its own; see packages/web/src/bin/web.ts
# — SPRINT3.md, 3.4 needs both, since the web app now decides approvals on two gateways, not one.
# SPRINT3.md, 3.3/3.4: the knowledge and endpoint agents' own certificates are the only credential
# anywhere in either gateway's path — those gateways themselves hold none, deliberately (see the
# README, "Knowledge gateway notes" and "Endpoint gateway notes").
AZURE_IDENTITY_AGENT_CLIENT_ID=
AZURE_IDENTITY_AGENT_CERT_THUMBPRINT=
AZURE_IDENTITY_AGENT_CERT_PATH=
AZURE_MDM_AGENT_CLIENT_ID=
AZURE_MDM_AGENT_CERT_THUMBPRINT=
AZURE_MDM_AGENT_CERT_PATH=
AZURE_KNOWLEDGE_AGENT_CLIENT_ID=
AZURE_KNOWLEDGE_AGENT_CERT_THUMBPRINT=
AZURE_KNOWLEDGE_AGENT_CERT_PATH=
AZURE_ENDPOINT_AGENT_CLIENT_ID=
AZURE_ENDPOINT_AGENT_CERT_THUMBPRINT=
AZURE_ENDPOINT_AGENT_CERT_PATH=

# Optional. Each gateway's own origin (no path) — both its MCP endpoint and, for the identity and
# endpoint gateways, their approval-decision endpoint live under this origin. Defaults match the
# gateways' own default ports.
IDENTITY_GATEWAY_URL=
MDM_GATEWAY_URL=
KNOWLEDGE_GATEWAY_URL=
ENDPOINT_GATEWAY_URL=
# Optional. The port each gateway listens on. Default: identity 3001, MDM 3002, knowledge 3003,
# endpoint 3004.
IDENTITY_GATEWAY_PORT=
MDM_GATEWAY_PORT=
KNOWLEDGE_GATEWAY_PORT=
ENDPOINT_GATEWAY_PORT=

# Optional. SQLite file holding the endpoint gateway's own audit chain and approval store, read
# directly by the web app for listing/deciding approvals (SPRINT3.md, 3.4), the same way
# HELPDESK_DB_PATH below already is for the identity gateway. Default: data/endpoint-helpdesk.db
ENDPOINT_HELPDESK_DB_PATH=

# Optional. SQLite files the web app reads (never writes) for the dashboard (SPRINT3.md, 3.5) —
# the three chains it did not already need for the approvals inbox. Defaults match each
# gateway's/the orchestrator's own default path, so a standard `pnpm *-gateway` / `pnpm web` setup
# needs none of these set.
ORCHESTRATOR_DB_PATH=
MDM_HELPDESK_DB_PATH=
KNOWLEDGE_HELPDESK_DB_PATH=

# As of SPRINT3.md 3.1, this is required for the web app to route any request at all: triage
# (packages/agent/src/triage.ts) makes one classification call per request, and the orchestration
# layer (orchestrator.ts) cannot dispatch to an agent without it. Also used for the approval
# rationale (Component 4), one model call per approval record — leave that one without a key and
# approvals are still created, just without a rationale (the gateway warns at startup); there is
# no equivalent fallback for triage, since routing is on the critical path for every request.
ANTHROPIC_API_KEY=
# Optional. Model for the rationale call. Default: claude-opus-5
HELPDESK_RATIONALE_MODEL=
# Optional. Model for triage's classification call. Default: claude-haiku-4-5-20251001 — cheap on
# purpose, since it runs once per request rather than once per approval.
HELPDESK_TRIAGE_MODEL=
# Optional. Model for the four agents' own turn (identity, mdm, knowledge, endpoint). Default:
# claude-sonnet-5 — see packages/agent/src/models.ts for why this tier sits between the other two.
HELPDESK_AGENT_MODEL=

# Optional. SQLite file holding the audit log and approvals. Default: data/identity-helpdesk.db
HELPDESK_DB_PATH=

# Optional. Port for the web app (packages/web). Default: 3000
WEB_PORT=
