{
  "name": "scoped-agent-helpdesk",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "verify-audit": "pnpm --filter @helpdesk/gateway build && node --no-warnings packages/gateway/dist/bin/verify-audit.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
